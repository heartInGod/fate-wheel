# ---- Python 运行产物 ----
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- 抓取缓存与快照（可重新拉取，体积 35MB 里占绝大部分）----
cache/

# ---- 技术侧运行日志（耗时/阶段/异常，logs/YYYY-MM-DD/ops.log）----
logs/

# ---- 运行时报告 ----
reports/

# ---- 手工备份 ----
backups/

# ---- 数据目录整体不追踪：业务报告 data/report/、公告档案、敏感台账、配置、研究数据、看板产物 ----
# 均为运行产物或本地台账，全部不入库；git 索引已用 git rm --cached 清空 data/。
data/

# ---- 抓取后自动刷新的档案（脚本维护，非源码）----
profiles/
data/announcements/

# ---- macOS / IDE / 工具本地状态 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
.workbuddy/
*.swp
*.swo

# ---- 个人持仓/账户敏感数据（不入库，远端历史亦应清除）----
data/portfolio/account.csv
data/portfolio/holdings.csv
data/portfolio/operations.csv

# ---- 密钥与本地配置 ----
.env
.env.*
*.key
*.pem
*_rsa
credentials*
secret*
config.local.*
# 通知配置含桥接 token，入库模板为 notify.example.json
config/notify.json
setup/wechat_bridge/bridge_config.json
setup/wechat_bridge/outbox.txt
